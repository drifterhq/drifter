#!/usr/bin/env bash

here=$(cd "$(dirname "$0")/.." && pwd)
bin=$here/target/release/drifter
[ -x "$bin" ] || bin=$here/target/debug/drifter
[ -x "$bin" ] || bin=$here/bin/drifter

state=${XDG_STATE_HOME:-$HOME/.local/state}/drifter
mkdir -p "$state"
log=$state/crash.log
err=$state/drifter.log
: >"$err"

export XDG_CURRENT_DESKTOP=drifter
export XDG_SESSION_DESKTOP=drifter
export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORMTHEME=${QT_QPA_PLATFORMTHEME:-gtk3}
export GTK_CSD=0
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export ELECTRON_OZONE_PLATFORM_HINT=${ELECTRON_OZONE_PLATFORM_HINT:-auto}

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd \
        XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE \
        GTK_CSD QT_WAYLAND_DISABLE_WINDOWDECORATION ELECTRON_OZONE_PLATFORM_HINT >/dev/null 2>&1 || true
fi

recent=()
while true; do
    "$bin" 2> >(tee -a "$err" >&2)
    code=$?
    if [ "$code" -eq 0 ]; then
        exit 0
    fi

    now=$(date +%s)
    echo "$(date -Is) drifter stopped with code $code, starting it again" >>"$log"
    kept=()
    for when in "${recent[@]}"; do
        [ $((now - when)) -lt 60 ] && kept+=("$when")
    done
    recent=("${kept[@]}" "$now")
    if [ "${#recent[@]}" -ge 4 ]; then
        echo "$(date -Is) four crashes in a minute, giving up" >>"$log"
        exit "$code"
    fi

    export DRIFTER_RECOVERED=1
    sleep 1
done
