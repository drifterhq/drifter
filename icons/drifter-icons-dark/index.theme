[Icon Theme]
Name=Drifter Dark
Comment=Drifter's own glass icons for the dark look
Inherits=Adwaita,hicolor
Example=folder
Directories=256x256/apps,256x256/places,256x256/devices,256x256/mimetypes

[256x256/apps]
Size=256
MinSize=16
MaxSize=512
Context=Applications
Type=Scalable

[256x256/places]
Size=256
MinSize=16
MaxSize=512
Context=Places
Type=Scalable

[256x256/devices]
Size=256
MinSize=16
MaxSize=512
Context=Devices
Type=Scalable

[256x256/mimetypes]
Size=256
MinSize=16
MaxSize=512
Context=MimeTypes
Type=Scalable
